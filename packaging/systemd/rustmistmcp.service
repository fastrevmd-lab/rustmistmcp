[Unit]
Description=rustmistmcp MCP server
Documentation=https://github.com/fastrevmd-lab/rustmistmcp
Wants=network-online.target
After=network-online.target
ConditionPathExists=/etc/rustmistmcp/mist.json
ConditionPathExists=/etc/rustmistmcp/audit-hmac.key

[Service]
Type=exec
User=rustmistmcp
Group=rustmistmcp
UMask=0077
ExecStart=/usr/local/bin/rustmistmcp \
    --device-mapping /etc/rustmistmcp/mist.json \
    --transport streamable-http \
    --host 127.0.0.1 \
    --port 30030 \
    --tokens-file /var/lib/rustmistmcp/tokens.json \
    --audit-format json \
    --audit-journald \
    --audit-redact devices=hmac,host=hmac,name=hmac,basename=hmac,command=hmac,pfe_command=hmac \
    --audit-hmac-key-file /etc/rustmistmcp/audit-hmac.key
StandardOutput=journal
StandardError=journal
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
StateDirectory=rustmistmcp
StateDirectoryMode=0700
RuntimeDirectory=rustmistmcp
RuntimeDirectoryMode=0700
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
NoNewPrivileges=true
ProcSubset=pid
ProtectProc=invisible
MemoryDenyWriteExecute=true
ProtectClock=true
ProtectHostname=true
CapabilityBoundingSet=
AmbientCapabilities=
ReadOnlyPaths=/etc/rustmistmcp
ReadWritePaths=/var/lib/rustmistmcp
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictNamespaces=true
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true
RemoveIPC=true
SystemCallArchitectures=native
# Without SystemCallErrorNumber=EPERM systemd's default raises SIGSYS and kills
# the process mid-request, which is what happened to rustunifimcp during a
# change-set state write (mecmcp#351). An EPERM denial is silent at the systemd
# layer; it can become visible only if the application stops discarding the errno.
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @obsolete @mount @swap @reboot @module
SystemCallErrorNumber=EPERM
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
# Egress policy -- DEFENCE IN DEPTH ONLY. Read this before relying on it.
#
# Mist reaches the Juniper Mist cloud API (internet HTTPS) and an SSDF evidence
# endpoint at 192.168.1.151:8443. Denying link-local and cloud metadata services
# has no legitimate impact on either.
#
# NOTE: IPAddressAllow/IPAddressDeny are accepted by systemd and reported by
# `systemctl show`, but are NOT enforced in an unprivileged LXC — systemd cannot
# attach the cgroup BPF program there. Every guest in this fleet is one. The
# directives stay because they do enforce on a normal host or privileged
# container, but do not read them as active protection here. The installer
# probes real enforcement and prints ENFORCED / NOT ENFORCED / NO POLICY /
# UNKNOWN. See the operations doc, "Enforcing it where systemd cannot" (mecmcp#322).
IPAddressAllow=localhost
IPAddressDeny=169.254.0.0/16 fe80::/10 fd00:ec2::254/128
# Makes enforcement observable: the byte counters are populated only when the
# BPF program actually attached. `[no data]` in systemctl status means the
# filters are inert.
IPAccounting=true
TasksMax=128
LimitNOFILE=32768

[Install]
WantedBy=multi-user.target
